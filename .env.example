# ARASS EVENTS — Environment Configuration Template

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arass_events?schema=public"

# Authentication & Sessions
AUTH_SECRET="arass-events-production-jwt-secret-key-32-chars-min"
AUTH_COOKIE_NAME="arass_events_session"

# Storage Configuration (Supabase / S3)
STORAGE_PROVIDER="memory" # options: "memory", "supabase", "s3"
STORAGE_BUCKET="arass-events"
STORAGE_ENDPOINT="https://your-project.supabase.co/storage/v1"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"

# Email Provider Configuration
EMAIL_PROVIDER="console" # options: "console", "resend", "sendgrid"
EMAIL_API_KEY="your-api-key"
EMAIL_FROM_ADDRESS="events@arass.technology"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
