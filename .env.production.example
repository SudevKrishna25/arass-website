# ARASS EVENTS — PRODUCTION ENVIRONMENT CONFIGURATION EXAMPLE
# Copy to .env.production and populate secrets prior to deployment

# 1. Platform URLs
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://events.arass.technology
NEXT_PUBLIC_EVENTS_URL=https://events.arass.technology

# 2. Database Connection (PostgreSQL 16+)
DATABASE_URL=postgresql://arass_app_user:StrongPasswordHere@postgres-cluster.internal:5432/arass_events?sslmode=require
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20

# 3. Session Security
SESSION_SECRET=GENERATE_64_BYTE_RANDOM_HEX_SECRET_FOR_JWT_SIGNING
JWT_EXPIRATION_SECONDS=604800

# 4. Email Infrastructure (Resend or SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_123456789abcdef
EMAIL_FROM_ADDRESS="ARASS EVENTS <notifications@events.arass.technology>"
EMAIL_REPLY_TO="support@events.arass.technology"

# 5. Persistent Object Storage (AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_BUCKET=arass-events-production-artifacts
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your_r2_access_key
STORAGE_SECRET_KEY=your_r2_secret_key
STORAGE_CDN_URL=https://storage.events.arass.technology

# 6. Distributed Rate Limiting & Jobs (Upstash / Redis)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# 7. Error Monitoring & Observability
SENTRY_DSN=https://your_sentry_key@o0.ingest.sentry.io/0000000
LOG_LEVEL=info

# 8. Super Administrator Initial Bootstrap Secret
BOOTSTRAP_ADMIN_SECRET=GENERATE_SUPER_SECURE_ONE_TIME_BOOTSTRAP_SECRET
BOOTSTRAP_ADMIN_EMAIL=founder@arass.technology
BOOTSTRAP_ADMIN_PASSWORD=InitialStrongPassword2026!
